# Multi-model support: downloaded per-model files live under models/<model_id>/.
# Only the hand-authored model_config.json for each model is tracked, plus PixAI's
# hand-curated tag translation CSVs (PixAI has no model_config.json - see constants.py).
models/*/*
!models/*/model_config.json
!models/pixai-tagger-v0.9/selected_tags_*.csv
